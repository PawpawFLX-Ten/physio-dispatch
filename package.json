{
  "name": "physio-dispatch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.js",
    "build": "vite build --config client/vite.config.js",
    "client": "vite --config client/vite.config.js --host 0.0.0.0 --port 5173",
    "test": "node --test tests/store.test.mjs tests/quick-order.test.mjs tests/body-pick.test.mjs tests/body-marks.test.mjs tests/pinyin.test.mjs tests/events.test.mjs tests/equipment.test.mjs",
    "test:ui": "node scripts/ui-e2e.mjs",
    "start:clinic": "bash scripts/start-clinic.sh",
    "optimize:body": "node scripts/optimize-body.mjs",
    "icons": "node scripts/make-icons.mjs",
    "lint": "eslint .",
    "test:equipment": "node scripts/equipment-e2e.mjs",
    "test:all": "npm test && npm run lint && npm run build && npm run test:ui && npm run test:equipment"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.1",
    "@vitejs/plugin-react": "^4.3.4",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.49.1",
    "tiny-pinyin": "^1.3.2",
    "vite": "^6.0.6"
  }
}
