{
  "name": "physio-dispatch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.js",
    "build": "vite build --config client/vite.config.js",
    "client": "vite --config client/vite.config.js --host 0.0.0.0 --port 5173",
    "test": "node --test tests/store.test.mjs tests/quick-order.test.mjs tests/body-pick.test.mjs tests/body-marks.test.mjs",
